    "@remix-run/node": "^2.15.2",
    "@remix-run/react": "^2.15.2",
    "@remix-run/serve": "^2.15.2",
    "@shopify/app-bridge-react": "^4.1.6",
    "@shopify/polaris": "^12.24.0",
    "@shopify/shopify-app-remix": "^3.4.0",
    "@shopify/shopify-app-session-storage-prisma": "^5.1.8",
    "@shopify/web-pixels-extension": "^0.1.3",
    "@vitejs/plugin-react": "^4.3.4",
    "isbot": "^5.1.17",
    "lucide-react": "^0.468.0",
    "prisma": "^5.22.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.2",
    "uuid": "^11.0.3",
    "vite": "^5.4.11",
    "vite-tsconfig-paths": "^5.1.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/uuid": "^10.0.0",
